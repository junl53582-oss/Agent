  },
  "confidence": {"low_upper": 0.4, "medium_upper": 0.7, "inputs": ["OOS skill", "calibration", "regime consistency", "sector stability", "distance from 0.5", "feature completeness", "PSI/z-score drift"]},
  "retraining_every_trading_days": 20,
  "immutable_daily_snapshots": true,
  "production_prediction_ready": false,
  "future_126d_confirmed": false,
  "execution_authorized": false,
