  "fixed_lightgbm": {"learning_rate": 0.04, "num_leaves": 15, "max_depth": 5, "min_data_in_leaf": 200, "feature_fraction": 0.8, "lambda_l1": 1.0, "lambda_l2": 5.0, "num_boost_round": 120, "seed": 42},
  "certification": {
    "auc_min_5d_20d": 0.52,
