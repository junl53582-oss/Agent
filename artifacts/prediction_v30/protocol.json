{
  "protocol": "stockpilot-v30-probabilistic-prediction-layer",
  "status": "preregistered_before_validation",
  "purpose": "Calibrated executable-open probability and return prediction for 1/5/20 trading-day horizons, independent from V6 ranking and from order execution.",
  "incumbent": "V6 remains the ranking incumbent; V29 remains an interrupted retrospective experiment.",
  "data": {
