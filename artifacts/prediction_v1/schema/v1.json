{
  "schema_version": "stockpilot-prediction-v1.0.0",
  "scope": "PRODUCT_INTERFACE_ONLY_NOT_MODEL_PROMOTION_EVIDENCE",
  "field_groups": {
    "identity": ["symbol", "stock_name", "industry", "prediction_date", "prediction_timestamp"],
    "coverage": ["universe_id", "eligibility_status", "data_coverage", "feature_coverage"],
    "raw_prediction": ["raw_rank_score", "return_1d_pred", "return_5d_pred", "return_20d_pred", "up_prob_1d", "up_prob_5d", "up_prob_20d", "rank_1d", "rank_5d", "rank_20d", "market_rank", "industry_rank"],
    "fusion_placeholders": ["stock_score", "ranking_score", "expected_return_score", "probability_score", "agreement_score", "industry_score", "regime_score", "confidence_score", "risk_score"],
    "explanation_placeholders": ["positive_drivers", "negative_drivers", "risk_drivers"],
    "governance": ["model_version", "feature_version", "schema_version", "training_cutoff", "data_snapshot_hash", "model_manifest_hash", "prediction_hash", "production_prediction_ready", "execution_authorized"],
    "provenance": ["source_kind", "source_artifact_path", "source_artifact_hash", "source_snapshot_hash", "adapter_version"]
  },
  "missing_value_policy": "null_not_fabricated",
  "universe_policy": "CSI300_VALIDATED_SCOPE_ONLY_UNTIL_NEW_PIT_UNIVERSE_EVIDENCE",
  "snapshot_policy": "ONE_IMMUTABLE_DAILY_SNAPSHOT_DERIVES_TOP10_TOP20_TOP50",
  "production_prediction_ready": false,
  "execution_authorized": false
}
