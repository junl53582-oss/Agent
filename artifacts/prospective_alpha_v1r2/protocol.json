  "missing_may_equal_zero": false,
  "prospective_results_may_tune_formula": false,
  "v30r1_forward_r2_logic_changed": false,
  "v31_training_allowed": false,
  "model_training_ready": false,
  "replacement_evaluation_ready": false,
  "production_prediction_ready": false,
  "execution_authorized": false
