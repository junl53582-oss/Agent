# Frozen prediction code is hashed byte-for-byte; keep its canonical LF form.
stockpilot/prediction/** text eol=lf
stockpilot/prediction_v30r1/** text eol=lf
tests/test_prediction_v30*.py text eol=lf

# Frozen reports, locks, models and snapshots must never receive line-ending conversion.
artifacts/prediction_v30/** -text
# The lightweight cache manifest is directly bound by V31 and was frozen from
# the Windows evidence workspace; materialize its canonical CRLF bytes in CI.
artifacts/prediction_v30/cache/manifest.json text eol=crlf
artifacts/prediction_v30r1/** -text

# Forward prediction revisions extend the same byte-for-byte freeze contract.
