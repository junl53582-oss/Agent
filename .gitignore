# 虚拟环境
.venv/
.venv311/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.env
tmp/
*.lnk

# WorkBuddy 工作元数据（不属于项目代码）
.workbuddy/

# 数据：原始、缓存、演示、影子行情一律不提交
data/

# 产物：默认忽略运行结果（净值/信号/预测 CSV、日志），
# 但保留不可篡改的冻结锁、协议、报告与审计链
artifacts/*
!artifacts/.gitkeep
!artifacts/*/
artifacts/**/*.csv
artifacts/**/*.parquet
artifacts/**/*.log
artifacts/**/*.png

# Prospective forward evidence is append-only runtime state, not source code.
# The frozen protocol/template are force-added and reviewed with the infrastructure PR.
artifacts/forward_evidence/**/forward_evidence_state.json
artifacts/forward_evidence/**/attempts/
artifacts/forward_evidence/**/predictions/
artifacts/forward_evidence/**/settlements/
artifacts/forward_evidence/**/checkpoints/

# Daily prediction product runtime outputs are immutable but local operational data.
artifacts/daily_predictions/**/predictions/
artifacts/daily_predictions/**/attempts/
artifacts/daily_predictions/**/latest.json
